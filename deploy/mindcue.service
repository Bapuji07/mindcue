[Unit]
Description=MindCue backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=mindcue
Group=mindcue
WorkingDirectory=/opt/mindcue
EnvironmentFile=/etc/mindcue.env
ExecStart=/usr/bin/java -jar /opt/mindcue/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mindcue

[Install]
WantedBy=multi-user.target
