# Local PostgreSQL / pgAdmin-backed server
DB_URL=jdbc:postgresql://localhost:5432/memory
DB_USERNAME=postgres
DB_PASSWORD=replace_me

# Backend
SERVER_PORT=8081
AUDIO_STORAGE_DIR=./data/audio

# Chat / memory extraction.
# Current example uses Gemini through its OpenAI-compatible chat endpoint.
MEMORY_CHAT_PROVIDER=openai-compatible
MEMORY_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MEMORY_CHAT_API_KEY=replace_me
MEMORY_CHAT_MODEL=gemini-3.6-flash
MEMORY_CHAT_TEMPERATURE=0.2

# Embeddings are OFF by default because your local PostgreSQL currently has no pgvector.
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_PROVIDER=openai-compatible
MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536

# Automatic transcription.
# Gemini works with the same Gemini API key, but keep it as a separate setting.
MEMORY_TRANSCRIPTION_PROVIDER=gemini
MEMORY_TRANSCRIPTION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MEMORY_TRANSCRIPTION_API_KEY=replace_me
MEMORY_TRANSCRIPTION_MODEL=gemini-3.6-flash
MEMORY_TRANSCRIPTION_LANGUAGE=

# Alternative OpenAI-compatible transcription configuration:
# MEMORY_TRANSCRIPTION_PROVIDER=openai-compatible
# MEMORY_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# MEMORY_TRANSCRIPTION_API_KEY=replace_me
# MEMORY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# MEMORY_TRANSCRIPTION_LANGUAGE=en
